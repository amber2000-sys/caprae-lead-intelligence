# ---------------------------------------------------------------------------
# Caprae Lead Intelligence — server configuration
# Copy this file to `.env` and adjust if needed. `.env` is git-ignored.
# ---------------------------------------------------------------------------

# Dedicated local database for this project.
# IMPORTANT: this project uses its OWN database (caprae_lead_intelligence).
# Do not point this at a shared, work, or production MongoDB instance —
# the seed script writes to the `companies` collection in whatever database
# this URI names.
MONGO_URI=mongodb://127.0.0.1:27017/caprae_lead_intelligence

# API server port
PORT=5000

# Environment: development | production | test
NODE_ENV=development

# Comma-separated list of origins allowed to call the API (the Vite dev server).
CORS_ORIGIN=http://localhost:5173
